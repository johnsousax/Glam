# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://glam-ingressos.vercel.app

# ---------- Supabase (projeto "Fluxo zero", tabelas glam_*) ----------
NEXT_PUBLIC_SUPABASE_URL=https://vpldivsicywvnvyczkhz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Painel Supabase > Project Settings > API Keys > service_role (NUNCA expor no navegador)
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Segurança ----------
# Chave para criptografar CPF (AES-256-GCM). Gere uma vez e não troque: openssl rand -base64 32
CPF_ENCRYPTION_KEY=
# Segredo compartilhado entre o site e o n8n (cabeçalho x-glam-secret)
GLAM_AUTOMACAO_SECRET=

# ---------- PagBank ----------
# Sem token o sistema roda em MODO DEMONSTRAÇÃO (pagamento simulado).
PAGBANK_TOKEN=
PAGBANK_ENV=sandbox   # sandbox | production

# ---------- n8n ----------
N8N_WEBHOOK_URL=      # URL de produção do Webhook do fluxo "GLAM | Eventos do site"

# ---------- Marketing ----------
NEXT_PUBLIC_META_PIXEL_ID=880769331739336

# Código de instalação para criar a conta do dono em /admin/setup (uso único)
GLAM_SETUP_TOKEN=
# Cloudflare Turnstile (opcional, anti-robô)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
